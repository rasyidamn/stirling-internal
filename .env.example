# Salin ke .env (atau jalankan scripts/generate-secrets.sh) lalu isi.
# File .env TIDAK boleh di-commit.

# ---- Umum ---------------------------------------------------------------
# Nama host yang dibuka staf di browser (tanpa https://)
PDF_HOSTNAME=pdftools.local
# Grup AD yang boleh memakai layanan (dicek Authelia DAN audit-proxy)
PDF_GROUP=GG-PDF-Users

# ---- Login --------------------------------------------------------------
# file = mode uji (akun dummy di authelia/users_database.yml)
# ldap = Active Directory (isi bagian AD di bawah)
AUTH_BACKEND=file

# Rahasia Authelia: diisi otomatis oleh scripts/generate-secrets.sh
AUTHELIA_SESSION_SECRET=GANTI_DENGAN_RANDOM_64_KARAKTER
AUTHELIA_STORAGE_ENCRYPTION_KEY=GANTI_DENGAN_RANDOM_64_KARAKTER
AUTHELIA_JWT_SECRET=GANTI_DENGAN_RANDOM_64_KARAKTER

# ---- Active Directory (hanya untuk AUTH_BACKEND=ldap) ---------------------
# Minta nilai-nilai ini ke admin AD. Lihat README bagian "Menghubungkan ke AD".
AD_LDAP_URL=ldaps://dc01.CONTOH.local:636
AD_TLS_SERVER_NAME=dc01.CONTOH.local
AD_BASE_DN=DC=CONTOH,DC=local
AD_BIND_USER=CN=svc-pdftools,OU=Service Accounts,DC=CONTOH,DC=local
AD_BIND_PASSWORD=ISI_PASSWORD_AKUN_SERVICE

# ---- audit-proxy --------------------------------------------------------
MAX_UPLOAD_MB=200
STIRLING_TIMEOUT=300
LOG_RETENTION_DAYS=365
# uid:gid pemilik folder ./logs di host (cek dengan: id -u ; id -g)
AUDIT_UID=1000
AUDIT_GID=1000
# Ruang RAM untuk file sementara saat upload diproses
TMPFS_SIZE=1g
# Upload yang diproses bersamaan (tiap upload memakai s.d. MAX_UPLOAD_MB di
# TMPFS). Jaga MAX_CONCURRENT_UPLOADS x (MAX_UPLOAD_MB + PAGE_COUNT_MAX_MB) < TMPFS_SIZE.
# Kelebihannya menunggu UPLOAD_QUEUE_TIMEOUT detik, lalu "Server sedang sibuk" (503).
MAX_CONCURRENT_UPLOADS=3
UPLOAD_QUEUE_TIMEOUT=30
# Jumlah halaman hanya dihitung untuk file s.d. ukuran ini (MB); file lebih
# besar tetap di-hash, kolom pages = null
PAGE_COUNT_MAX_MB=50
# true = operasi PDF ditolak (503) selama log audit tidak bisa ditulis.
# false = staf tetap dilayani walau tidak tercatat (/healthz tetap 503).
AUDIT_FAIL_CLOSED=false
# Allowlist API Stirling (dipisah koma). Kosong = daftar bawaan di
# audit-proxy/app/config.py. "*" = allowlist mati (hanya blocklist).
ALLOWED_API_PREFIXES=
# Batas tunggu Caddy ke audit-proxy. Harus > STIRLING_TIMEOUT (+30 detik).
CADDY_UPSTREAM_TIMEOUT=330s
# Opsional: salinan log ke syslog remote (kosongkan untuk mematikan)
SYSLOG_HOST=
SYSLOG_PORT=514
SYSLOG_PROTOCOL=udp
